{
  "name": "dsh-skill-writing-plans",
  "description": "DeepSeek Harness skill plugin that adds the 'writing-plans' skill: generates a structured implementation plan document before coding, then executes simple tasks inline or offers an execution choice for complex work.",
  "version": "0.1.1",
  "author": "linlin539",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linlin539/dsh-skill-writing-plans.git"
  },
  "bugs": {
    "url": "https://github.com/linlin539/dsh-skill-writing-plans/issues"
  },
  "homepage": "https://github.com/linlin539/dsh-skill-writing-plans#readme",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "skill",
    "writing-plans",
    "trae",
    "plugin"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ]
}
